{{> head}}
{{> header}}

<main>
    <h1>Edit Course</h1>
    <form action='/organiser/courses/{{course.id}}/edit' method='post'>
        <div>
            <label for='title'>Title</label>
            <input type='text' id='title' name='title' value='{{course.title}}' required />
        </div>
        <div>
            <label for='description'>Description</label>
            <textarea id='description' name='description'>{{course.description}}</textarea>
        </div>
        <div>
            <label for='level'>Level</label>
            <select id='level' name='level'>
                <option value='beginner' {{#course.isLevelBeginner}}selected{{/course.isLevelBeginner}}>Beginner</option>
                <option value='intermediate' {{#course.isLevelIntermediate}}selected{{/course.isLevelIntermediate}}>Intermediate</option>
                <option value='advanced' {{#course.isLevelAdvanced}}selected{{/course.isLevelAdvanced}}>Advanced</option>
            </select>
        </div>
        <div>
            <label for='type'>Type</label>
            <select id='type' name='type'>
                <option value='WEEKLY_BLOCK' {{#course.isWeeklyBlock}}selected{{/course.isWeeklyBlock}}>Weekly Block</option>
                <option value='WEEKEND_WORKSHOP' {{#course.isWeekendWorkshop}}selected{{/course.isWeekendWorkshop}}>Weekend Workshop</option>
            </select>
        </div>
        <div>
            <label>
                <input type='checkbox' name='allowDropIn' {{#course.allowDropIn}}checked{{/course.allowDropIn}} />
                Allow Drop-ins
            </label>
        </div>
        <div>
            <label for='startDate'>Start Date</label>
            <input type='date' id='startDate' name='startDate' value='{{course.startDate}}' />
        </div>
        <div>
            <label for='endDate'>End Date</label>
            <input type='date' id='endDate' name='endDate' value='{{course.endDate}}' />
        </div>
        <button class='btn' type='submit'>Save Changes</button>
        <a href='/organiser'>Cancel</a>
    </form>
</main>

{{> footer}}