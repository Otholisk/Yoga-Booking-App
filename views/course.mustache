
{{> head}}
{{> header}}

<article>
  <h1>{{course.title}}</h1>
  <p class='muted'>
    Level: {{course.level}} • Type: {{course.type}} {{#course.allowDropIn}}• Drop-in available{{/course.allowDropIn}}
  </p>
  <p>{{course.description}}</p>
  <p class='muted'>Dates: {{course.startDate}} – {{course.endDate}}</p>

  <section>
      <form action='/courses/{{course.id}}/book' method='post'>
          <button class='btn primary' type='submit'>Book This Course</button>
      </form>
  </section>

  <section>
    <h2>Sessions</h2>
    <table class='table'>
      <thead>
        <tr>
          <th>Start</th>
          <th>End</th>
          <th>Capacity</th>
          <th>Booked</th>
          <th>Remaining</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#sessions}}
        <tr>
          <td>{{start}}</td>
          <td>{{end}}</td>
          <td>{{capacity}}</td>
          <td>{{remaining}}</td>
          <td>

            <form action='/sessions/{{id}}/book' method='post'>
                <button class='btn' type='submit' {{#isFull}}disabled{{/isFull}}>Book Session</button>
            </form>
          </td>
        </tr>
        {{/sessions}}
      </tbody>
    </table>
  </section>
</article>

{{> footer}}
